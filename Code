//Problem 1 - APCS Post Office
import java.util.Scanner;

public class Problem1 {
    
    public static void mailCost(double length, double width, double thick, double weight) {
        
        if(length >= 3.5 && length <= 4.25 && width >= 3.5 && width <= 6 && thick >= .007 && thick <= .016) {
                    
                    double lbRate = weight/.0625;
                    lbRate = Math.ceil(lbRate);
                    double cost = (lbRate *.2);
                    System.out.printf("$%.2f", cost);
                    
        }
        else if(length >= 4.25 && length <= 6 && width >= 6 && width <= 11.5 && thick >= .007 && thick <= .016) {
                    
                    double lbRate = weight/.0625;
                    lbRate = Math.ceil(lbRate);
                    double cost = (lbRate *.3);
                    System.out.printf("$%.2f", cost);;
                    
        }
        else if(length >= 3.5 && length <= 6.125 && width >= 5 && width <= 11.5 && thick >= .016 && thick <= .25) {
                    
                    double lbRate = weight/.0625;
                    lbRate = Math.ceil(lbRate);
                    double cost = (lbRate *.47);
                    System.out.printf("$%.2f", cost);
                    
        }
        else if(length >= 6.125 && length <= 24 && width >= 11 && width <= 18 && thick >= .25 && thick <= .5) {
                    
                double lbRate = weight/.0625;
                lbRate = Math.ceil(lbRate);
                double cost = (lbRate *.56);
                System.out.printf("$%.2f", cost);
                    
        }
        else if(length > 24 || width > 18 || thick > .5 && length + (2 * width) + (2 * thick) <= 84) {
            
            double lbRate = weight/.5;
            lbRate = Math.ceil(lbRate);
            double cost = (lbRate *1.5);
            System.out.printf("$%.2f", cost);
                    
        }
       else if((length > 24 || width > 18 || thick > .5) && length + (2 * width) + (2 * thick) > 84 && length + (2 * width) + (2 * thick) <= 130) {
            
            double lbRate = weight/.5;
            lbRate = Math.ceil(lbRate);
            double cost = (lbRate *1.75);
            System.out.printf("$%.2f", cost);
                    
        }
        else {
            System.out.println("UNMAILABLE");
        }
}    
    
    public static void main(String[] args) {
        
        Scanner reader = new Scanner(System.in);
        
        System.out.print("Enter the length of the mail:");
        double length = reader.nextDouble();
        
        System.out.print("Enter the width of the mail:");
        double width = reader.nextDouble();
        
        System.out.print("Enter the thickness of the mail:");
        double thick = reader.nextDouble();
        
        System.out.print("Enter the weight of the mail:");
        double weight = reader.nextDouble();
        
        mailCost(length,width,thick,weight);
        
        for(int i = 0;i < 4;i++) {
            
            System.out.println("\n");
            
            System.out.print("Enter the length of the mail:");
            length = reader.nextDouble();
            
            System.out.print("Enter the width of the mail:");
            width = reader.nextDouble();
            
            System.out.print("Enter the thickness of the mail:");
            thick = reader.nextDouble();
            
            System.out.print("Enter the weight of the mail:");
            weight = reader.nextDouble();
            
            mailCost(length,width,thick,weight);
        
        }
        
    }
}
